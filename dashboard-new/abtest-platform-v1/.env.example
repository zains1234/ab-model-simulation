PORT=8080
HOST=127.0.0.1

# Leave empty until the office CDN/Git/Jenkins deployment flow is agreed.
# When configured, this command runs after the server generates ./temp/production.
# The command must publish that directory and should exit 0 only after deployment completes.
# On success the server clears temp/; on failure it keeps workspace.json and removes production/.
DEPLOY_COMMAND=
